{
  "name": "pipeline-lab",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.21.0 <23"},
  "scripts": {
    "start": "node v2/server.mjs",
    "demo": "node v2/server.mjs",
    "lab:demo-data": "node v2/load-demo.mjs",
    "test": "node --test v2/tests/*.test.mjs",
    "lab:setup": "node v2/setup.mjs",
    "lab:prepare": "node v2/prepare.mjs",
    "lab:pilot": "node v2/runner.mjs --workloads invoice --modes baseline,combined --scenario source-change --repeats 1",
    "lab:benchmark": "node v2/runner.mjs --workloads invoice,publisher,lean --modes baseline,combined --scenario source-change --repeats 3",
    "lab:proof": "node v2/runner.mjs --workloads invoice --modes combined --scenario failure --repeats 1",
    "lab:audit": "node v2/audit.mjs",
    "lab:export": "node v2/publish.mjs",
    "ci": "node v2/github-run.mjs"
  }
}
