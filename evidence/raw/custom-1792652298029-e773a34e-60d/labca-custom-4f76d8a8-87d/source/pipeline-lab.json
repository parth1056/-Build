{
  "schema": 1,
  "name": "statuslens",
  "baseImage": "node@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205",
  "workspace": {
    "before": "Dockerfile.after",
    "after": "Dockerfile.after",
    "target": "workspace"
  },
  "checks": [
    {
      "name": "lint",
      "command": [
        "npm",
        "run",
        "lint"
      ]
    },
    {
      "name": "types",
      "command": [
        "npm",
        "run",
        "types"
      ]
    },
    {
      "name": "tests",
      "command": [
        "npm",
        "test"
      ]
    }
  ],
  "build": {
    "command": [
      "npm",
      "run",
      "build"
    ],
    "output": "/app/dist"
  },
  "runtime": {
    "dockerfile": "Dockerfile.runtime"
  },
  "verify": {
    "command": [
      "node",
      "verify.mjs"
    ],
    "expected": {
      "application": "statuslens",
      "serviceCount": 4,
      "degradedCount": 1,
      "errorRateLimit": 0.02,
      "assetsServed": true
    },
    "changedExpected": {
      "application": "statuslens",
      "serviceCount": 4,
      "degradedCount": 2,
      "errorRateLimit": 0.01,
      "assetsServed": true
    }
  },
  "change": {
    "file": "src/config.json",
    "from": "\"errorRateLimit\":0.02",
    "to": "\"errorRateLimit\":0.01"
  },
  "failure": {
    "file": "src/status.ts",
    "from": "x.latencyMs>config.latencyLimitMs||x.errorRate>config.errorRateLimit",
    "to": "x.latencyMs>config.latencyLimitMs&&x.errorRate>config.errorRateLimit"
  },
  "dependencyStep": "npm ci",
  "exclude": [
    "dist",
    ".generated"
  ],
  "options": {
    "beforeParallelism": 3,
    "parallelism": 3,
    "timeoutSeconds": 600,
    "cpus": 1,
    "memory": "1g",
    "network": "none"
  }
}
